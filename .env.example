# Copy this file to .env and fill in real values for local development.
# .env itself is gitignored — never commit real keys/secrets.

# RS256 keypair used by the Auth Service to sign JWTs and by every other
# service (starting with the Gateway) to verify them. Generate a dev
# keypair with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# then paste each PEM's contents below with real newlines replaced by \n.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Postgres — a containerized service (docker-compose.yml's "postgres"),
# not a native host install. One shared instance, isolated schema per
# service, each schema created automatically by that service's own
# init_db() on first boot — no manual role/database setup needed. No host
# port is published by default (only other containers reach it, over the
# internal Docker network as "postgres"); add a `ports:` mapping to the
# postgres service in docker-compose.yml if you want host-side psql access.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=creditflow
POSTGRES_PASSWORD=creditflow
POSTGRES_DB=creditflow

# Frontend — left empty on purpose: with nginx unifying the frontend and
# Gateway under one origin (see nginx/nginx.conf), apiFetch's relative
# paths resolve correctly against whatever origin the page was actually
# loaded from (nginx on :80, or the public ngrok URL). Only set this to a
# host:port if you're bypassing nginx and hitting the frontend dev server
# directly on :5173 with the Gateway reachable at that same explicit URL.
VITE_API_BASE_URL=

# Stripe sandbox/test-mode — placeholders. Replace with real test-mode
# values from your Stripe dashboard before exercising checkout/webhooks
# end-to-end. STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you
# register (or from `stripe listen --print-secret` for local testing).
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PRICE_PRO=price_pro_placeholder
STRIPE_PRICE_TEAM=price_team_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Groq — placeholder. Replace with a real key from
# https://console.groq.com/keys before exercising AI generation
# end-to-end. (The platform spec names OpenRouter as the text AI
# provider; this project uses Groq instead — same OpenAI-compatible
# chat completions shape, different host/key/model catalog.)
GROQ_API_KEY=gsk_placeholder

# LinkedIn — placeholders. Each developer registers their own LinkedIn
# Developer App for local testing (products: "Sign In with LinkedIn using
# OpenID Connect" and "Share on LinkedIn"; scopes: openid profile email
# w_member_social). LINKEDIN_REDIRECT_URI must exactly match a redirect
# URL registered on that app.
LINKEDIN_CLIENT_ID=linkedin-client-id-placeholder
LINKEDIN_CLIENT_SECRET=linkedin-client-secret-placeholder
LINKEDIN_REDIRECT_URI=http://localhost:8080/social/linkedin/callback
FRONTEND_CONNECTIONS_URL=http://localhost:5173/linkedin-connections

# Fernet keys for the Social Publishing service (token-at-rest encryption
# and OAuth state signing) — dev-default placeholders already generated
# for this repo. Rotate via env vars (32 random bytes, base64 urlsafe)
# before a real deployment.
TOKEN_ENCRYPTION_KEY=gGLNraB90AVpJD2_S0MA8qURS80AvCLzs96rMpEkCRw=
OAUTH_STATE_KEY=Pn_HZpWVb9vdcDE5ILlBxerWRG-xM_JIShAh90Gl2y8=

# SMTP — placeholders. For Gmail: enable 2-Step Verification on the
# account, then generate an App Password at
# myaccount.google.com/apppasswords (a 16-character code — NOT your real
# Gmail password) and use it as SMTP_PASSWORD. Unlike Resend's free tier,
# a normal SMTP account has no "verified recipient" restriction — mail
# sends to any real address immediately, no domain verification needed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=smtp-placeholder@gmail.com
SMTP_PASSWORD=smtp-placeholder
SMTP_FROM_EMAIL=CreditFlow <smtp-placeholder@gmail.com>

# Slack Incoming Webhook — optional (per the spec, no OAuth app review
# needed). Leave empty to just log ops alerts instead of posting them.
SLACK_WEBHOOK_URL=
FRONTEND_BASE_URL=http://localhost:5173

# nginx (docker-compose service `nginx`, config at nginx/nginx.conf) puts
# the frontend and every Gateway route behind one origin; ngrok (service
# `ngrok`) tunnels that origin to a public HTTPS URL so LinkedIn OAuth
# callbacks and Stripe webhooks can reach a local docker-compose stack.
# NGROK_AUTHTOKEN: required, free account + token at ngrok.com.
# NGROK_STATIC_DOMAIN: required by docker-compose.yml's ngrok service
# (passed as --domain) — every free ngrok account is issued exactly one
# permanent "dev domain" for free, shown on the Domains page of the
# dashboard (dashboard.ngrok.com/domains); copy that hostname here. Without
# it, the ngrok container's --domain flag would be empty and fail to start.
# Once set, the public URL never changes across restarts, so
# LINKEDIN_REDIRECT_URI/FRONTEND_CONNECTIONS_URL/FRONTEND_BASE_URL above and
# the LinkedIn app's own registered redirect URI only ever need setting once
# — update all three to that same https://<your-domain> once you know it.
NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=
