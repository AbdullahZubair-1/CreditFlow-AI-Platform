# Copy this file to .env and fill in real values for local development.
# .env itself is gitignored — never commit real keys/secrets.

# RS256 keypair used by the Auth Service to sign JWTs and by every other
# service (starting with the Gateway) to verify them. Generate a dev
# keypair with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# then paste each PEM's contents below with real newlines replaced by \n.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Postgres — runs natively on the host, not in Docker (see the README's
# "Local setup" section for creating the role/database and the
# pg_hba.conf rule Docker needs to reach it). One shared instance,
# isolated schema per service.
#   psql -U postgres -c "CREATE ROLE creditflow LOGIN PASSWORD 'creditflow';"
#   psql -U postgres -c "CREATE DATABASE creditflow OWNER creditflow;"
# POSTGRES_HOST defaults to host.docker.internal (how containers reach
# the host on Docker Desktop for Windows/Mac); on native Linux Docker use
# the host's LAN IP or --add-host instead.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=creditflow
POSTGRES_PASSWORD=creditflow
POSTGRES_DB=creditflow

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Stripe sandbox/test-mode — placeholders. Replace with real test-mode
# values from your Stripe dashboard before exercising checkout/webhooks
# end-to-end. STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you
# register (or from `stripe listen --print-secret` for local testing).
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PRICE_PRO=price_pro_placeholder
STRIPE_PRICE_TEAM=price_team_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# OpenRouter — placeholder. Replace with a real key from
# https://openrouter.ai/keys before exercising AI generation end-to-end.
OPENROUTER_API_KEY=sk-or-placeholder

# LinkedIn — placeholders. Each developer registers their own LinkedIn
# Developer App for local testing (products: "Sign In with LinkedIn using
# OpenID Connect" and "Share on LinkedIn"; scopes: openid profile email
# w_member_social). LINKEDIN_REDIRECT_URI must exactly match a redirect
# URL registered on that app.
LINKEDIN_CLIENT_ID=linkedin-client-id-placeholder
LINKEDIN_CLIENT_SECRET=linkedin-client-secret-placeholder
LINKEDIN_REDIRECT_URI=http://localhost:8080/social/linkedin/callback
FRONTEND_CONNECTIONS_URL=http://localhost:5173/linkedin-connections

# Fernet keys for the Social Publishing service (token-at-rest encryption
# and OAuth state signing) — dev-default placeholders already generated
# for this repo. Rotate via env vars (32 random bytes, base64 urlsafe)
# before a real deployment.
TOKEN_ENCRYPTION_KEY=gGLNraB90AVpJD2_S0MA8qURS80AvCLzs96rMpEkCRw=
OAUTH_STATE_KEY=Pn_HZpWVb9vdcDE5ILlBxerWRG-xM_JIShAh90Gl2y8=

# Resend — placeholder. Replace with a real key from
# https://resend.com/api-keys before exercising real email delivery
# end-to-end; the sandbox `onboarding@resend.dev` sender works without a
# verified domain for testing.
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=CreditFlow <onboarding@resend.dev>

# Slack Incoming Webhook — optional (per the spec, no OAuth app review
# needed). Leave empty to just log ops alerts instead of posting them.
SLACK_WEBHOOK_URL=
FRONTEND_BASE_URL=http://localhost:5173
